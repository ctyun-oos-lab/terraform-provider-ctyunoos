// expandEndpointCustomEnvVar reads the OOS custom endpoint environment variables (CTYUNOOS_*).
// It takes effect only when the endpoints{} configuration block does not specify the service; the configuration block takes precedence.
func expandEndpointCustomEnvVar(pkg, customEnvVar string, endpoints map[string]string) {
	if endpoints[pkg] == "" {
		if v := os.Getenv(customEnvVar); v != "" {
			endpoints[pkg] = v
		}
	}
